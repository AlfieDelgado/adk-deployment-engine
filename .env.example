# Google Cloud Project
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-here"

# API Location (for ADK/Gemini endpoints)
# Use "global" for preview models like Gemini 3 Flash, or region like "us-central1"
GOOGLE_CLOUD_LOCATION="your-google-cloud-location-here"

# Deployment Location (for Cloud Run, Agent Engine, and other GCP resources)
# Must be an actual region like "us-central1", "us-east1", etc.
# Optional: Falls back to GOOGLE_CLOUD_LOCATION if not set
GOOGLE_CLOUD_LOCATION_DEPLOY="your-google-cloud-deployment-region-here"

# API Configuration
# Option 1: Enterprise auth mode (set GOOGLE_GENAI_USE_ENTERPRISE=true)
# Option 2: Gemini Developer API mode (set GOOGLE_GENAI_USE_ENTERPRISE=false and provide GOOGLE_API_KEY)
# Note: GOOGLE_GENAI_USE_VERTEXAI is a deprecated alias that is still honored as a fallback
GOOGLE_GENAI_USE_ENTERPRISE="true-or-false-to-use-enterprise-mode-here"
GOOGLE_API_KEY="your-google-api-key-here"